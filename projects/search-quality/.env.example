# 复制为 .env，将所需平台的 API Key 填入下面的单引号中。
# 前端服务自动读取；CLI 在项目目录执行 source .env 后运行 quality_eval。
export DEEPSEEK_API_KEY=''

# 千问AI平台：https://platform.qianwenai.com/home/api-keys
export QIANWEN_API_KEY=''

# 智谱 BigModel 平台：https://bigmodel.cn
export ZHIPU_API_KEY=''

# TokenDance 的 Ateve-Jev：https://tokendance.space/keys
export ATEVE_JEV_API_KEY=''
